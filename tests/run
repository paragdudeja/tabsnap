#!/bin/zsh
# tests/run — offline tests for tabsnap. No browser tabs are opened or closed,
# and triage runs against a stubbed API, so this is safe to run anywhere.

REPO="${0:A:h:h}"
WORK=$(mktemp -d)
trap 'rm -rf "$WORK"' EXIT
PASS=0
FAIL=0

ok()   { PASS=$((PASS + 1)); echo "  ✓ $1"; }
fail() { FAIL=$((FAIL + 1)); echo "  ✗ $1"; [[ -n "$2" ]] && echo "$2" | sed 's/^/      /'; }
# expect <name> <haystack> <needle>
expect() { [[ "$2" == *"$3"* ]] && ok "$1" || fail "$1" "expected to contain: $3"$'\n'"got: $2"; }
expect_not() { [[ "$2" != *"$3"* ]] && ok "$1" || fail "$1" "expected NOT to contain: $3"$'\n'"got: $2"; }

echo "syntax"
for f in "$REPO"/tabsnap "$REPO"/tabsnap-* "$REPO"/release "$REPO"/swiftbar/*(N); do
  zsh -n "$f" 2>/dev/null && ok "${f:t} parses" || fail "${f:t} parses" "$(zsh -n "$f" 2>&1)"
done

echo "cli"
expect "--version" "$("$REPO/tabsnap" --version)" "tabsnap "
expect "--help lists restore" "$("$REPO/tabsnap" --help)" "tabsnap restore"

echo "config"
CFG="$WORK/config"
printf 'dir = ~/first\nkeep = a.com\n  # comment\nkeep =  b.com , c.com  \nwarn=12\nbogus = 1\n' > "$CFG"
out=$(TABSNAP_CONFIG="$CFG" "$REPO/tabsnap" config 2>&1)
expect "later lines win" "$out" "keep  = b.com , c.com"
expect "expands ~" "$out" "dir   = $HOME/first"
expect "parses warn" "$out" "warn  = 12"
expect "warns on unknown key" "$out" "ignoring unknown key 'bogus'"
expect "env beats file" "$(TABSNAP_CONFIG="$CFG" TABSNAP_WARN=99 "$REPO/tabsnap" config 2>/dev/null)" "warn  = 99"
expect "defaults without file" "$(TABSNAP_CONFIG="$WORK/none" "$REPO/tabsnap" config)" "warn  = 30"

echo "targeting"
# These all fail during argument parsing, before any browser is touched
out=$("$REPO/tabsnap" --browser firefox 2>&1); expect "rejects unknown browser" "$out" "should be one of: brave, chrome"
out=$("$REPO/tabsnap" --browser e 2>&1); expect "rejects ambiguous browser" "$out" "should be one of"
out=$("$REPO/tabsnap" --window 2>&1); expect "--window needs a value" "$out" "--window needs a value"
out=$("$REPO/tabsnap" --clsoe 2>&1); expect "rejects typo'd flags" "$out" "unknown option --clsoe"
expect "--help documents --window" "$("$REPO/tabsnap" --help)" "--window   only the front window"

echo "json + agents"
out=$("$REPO/tabsnap" config --json)
print -r -- "$out" | jq -e '.dir and (.keep | type == "array")' >/dev/null && ok "config --json is structured" || fail "config --json is structured" "$out"
out=$(TABSNAP_KEEP=" a.com , b.com" "$REPO/tabsnap" config --json | jq -c .keep)
expect "config --json splits keep list" "$out" '["a.com","b.com"]'
out=$("$REPO/tabsnap" list --json 2>&1)
print -r -- "$out" | jq -e '(.tabs | type == "array") and (.total | type == "number")' >/dev/null && ok "list --json is valid" || fail "list --json is valid" "$out"
expect "list refuses --close" "$("$REPO/tabsnap" list --close 2>&1)" "only shows tabs"
[[ "$(grep -c '^name: tabsnap$' "$REPO/skills/tabsnap/SKILL.md")" == 1 ]] && ok "skill has frontmatter" || fail "skill has frontmatter"
jq -e '.name == "tabsnap"' "$REPO/.claude-plugin/plugin.json" >/dev/null && ok "plugin manifest" || fail "plugin manifest"

echo "setup"
FH="$WORK/home"; mkdir -p "$FH"
out=$(HOME="$FH" TABSNAP_CONFIG="$WORK/setup-cfg" TABSNAP_DIR="$WORK/setup-snaps" "$REPO/tabsnap" setup --no-menu-bar </dev/null 2>&1)
expect "setup writes config" "$(cat "$WORK/setup-cfg" 2>/dev/null)" "keep = mail.google.com"
[[ ! -e "$FH/.claude/skills/tabsnap" ]] && ok "no terminal: setup installs nothing optional" || fail "no terminal: setup installs nothing optional"
mkdir -p "$FH/.claude"
out=$(HOME="$FH" TABSNAP_CONFIG="$WORK/setup-cfg" "$REPO/tabsnap" setup --yes --no-menu-bar </dev/null 2>&1)
[[ -f "$FH/.claude/skills/tabsnap/SKILL.md" ]] && ok "--yes links the Claude Code skill" || fail "--yes links the Claude Code skill" "$out"
expect "setup rejects unknown flags" "$("$REPO/tabsnap" setup --bogus 2>&1)" "unknown option --bogus"

echo "restore"
SNAP="$WORK/snaps/tabs_2026-01-01_00-00-00.md"
mkdir -p "$WORK/snaps"
cat > "$SNAP" <<'EOF'
# Tab snapshot — 2026-01-01 00:00:00 UTC

## Safari — 4 tabs

### Window 1 (4 tabs)

- [ ] [Open me](https://example.com/a)
- [x] [Already done](https://example.com/b)
- [ ] [Has \[brackets\]](https://en.wikipedia.org/wiki/Foo_(bar))
- [X] [Done uppercase](https://example.com/c)
- [ ] [C:\\temp \n backslashes](https://example.com/e?token=SECRET#frag)

## Not A Browser — 1 tabs

- [ ] [Unknown section](https://example.com/d)
EOF
out=$("$REPO/tabsnap" restore --dry-run "$SNAP" 2>&1)
expect "counts unticked tabs" "$out" "Would reopen 4 tabs"
expect "keeps source browser" "$out" "[Safari] https://example.com/a"
expect "url with parentheses" "$out" "https://en.wikipedia.org/wiki/Foo_(bar)"
expect "unknown header → default browser" "$out" "[default] https://example.com/d"
expect_not "skips ticked tabs" "$out" "example.com/b"
expect "--all includes ticked" "$("$REPO/tabsnap" restore --all --dry-run "$SNAP")" "Would reopen 6 tabs"

printf -- '-  [ ] [two spaces](https://e.com/1)\n- [ ]  [gap](https://e.com/2)\n  - [ ] [nested](https://e.com/3)\n* [ ] [star](https://e.com/4)\n+ [x] [plus ticked](https://e.com/5)\n- [] [no box space](https://e.com/6)\n' > "$WORK/hand-edited.md"
out=$("$REPO/tabsnap" restore --dry-run "$WORK/hand-edited.md")
expect "accepts hand-edited checkbox spacing" "$out" "Would reopen 4 tabs"
expect_not "still skips malformed boxes" "$out" "e.com/6"

printf -- '## Safari — 4 tabs\n\n- [ ] [a](https://e.com/a)\n- [ ] [a again](https://e.com/a)\n- [ ] [b](https://e.com/b)\n- [ ] [a 3rd](https://e.com/a)\n' > "$WORK/dupes.md"
out=$("$REPO/tabsnap" restore --dry-run "$WORK/dupes.md")
expect "restore opens each url once" "$out" "Would reopen 2 tabs from dupes.md (skipped 2 duplicates; --all-copies to include)"
expect "--all-copies keeps duplicates" "$("$REPO/tabsnap" restore --dry-run --all-copies "$WORK/dupes.md")" "Would reopen 4 tabs from dupes.md:"
expect "restore rejects unknown options" "$("$REPO/tabsnap" restore --bogus 2>&1)" "unknown option --bogus"

TRIAGE="$WORK/snaps/tabs_2026-01-01_00-00-00.triage.md"
cat > "$TRIAGE" <<'EOF'
## Reading (2)

- [ ] [Article](https://example.com/article) — a note `📖 read later`
- [x] [Old](https://example.com/old) — done `✅ done`
EOF
out=$("$REPO/tabsnap" restore --dry-run "$TRIAGE")
expect "triage file: unticked only" "$out" "Would reopen 1 tabs"
expect "triage file: strips note" "$out" "[default] https://example.com/article"

touch -t 202601020000 "$TRIAGE"   # triage file is newest; latest must still pick the snapshot
expect "latest skips triage files" "$(TABSNAP_DIR="$WORK/snaps" "$REPO/tabsnap" restore --dry-run)" "from tabs_2026-01-01_00-00-00.md"

out=$(TABSNAP_DIR="$WORK/empty" "$REPO/tabsnap" restore 2>&1)
expect "empty dir message" "$out" "No snapshots found"
expect_not "empty dir has no glob error" "$out" "no matches found"

echo "triage"
mkdir -p "$WORK/bin"
cat > "$WORK/bin/curl" <<EOF
#!/bin/zsh
# stub: save the request body, reply with a canned triage
while (( \$# )); do case "\$1" in -o) out="\$2"; shift;; -d) print -r -- "\$2" > "$WORK/request.json"; shift;; esac; shift; done
jq -n --arg t '{"overview":"Testing.","groups":[{"theme":"Reading","summary":"Docs.","tabs":[{"id":1,"note":"Keep it","action":"reference"}]}],"duplicates":[[1,2]]}' \
  '{model:"claude-opus-5-5",stop_reason:"end_turn",content:[{type:"text",text:\$t}]}' > "\$out"
printf 200
EOF
chmod +x "$WORK/bin/curl"
out=$(PATH="$WORK/bin:$PATH" ANTHROPIC_API_KEY=test "$REPO/tabsnap" triage "$SNAP" 2>&1)
expect "triage saves file" "$out" "Saved triage"
md=$(cat "$TRIAGE")
expect "renders group" "$md" "## Reading (1)"
expect "renders note and badge" "$md" "— Keep it \`📌 reference\`"
expect "lists unsorted tabs" "$md" "## Unsorted (5)"
expect "lists duplicates" "$md" "Open me = Already done"
req=$(cat "$WORK/request.json")
expect "request uses fallbacks" "$req" '"fallbacks": "default"'
expect "request sends tabs" "$req" "1. Open me — https://example.com/a"
expect "keeps backslashes in titles" "$req" 'C:\\\\temp'
expect "strips query and fragment" "$req" "backslashes — https://example.com/e\\n"
expect_not "never sends the token" "$req" "SECRET"
expect "report keeps full url" "$md" "https://example.com/e?token=SECRET#frag"
PATH="$WORK/bin:$PATH" ANTHROPIC_API_KEY=test TABSNAP_TRIAGE_FULL_URLS=1 "$REPO/tabsnap" triage "$SNAP" >/dev/null 2>&1
expect "opt-in sends full url" "$(cat "$WORK/request.json")" "e?token=SECRET#frag"

out=$(PATH="/usr/bin:/bin:${$(command -v jq):h}" env -u ANTHROPIC_API_KEY "$REPO/tabsnap" triage "$SNAP" 2>&1)
expect "no key and no claude → clear error" "$out" "needs either ANTHROPIC_API_KEY or the Claude Code CLI"

echo "search"
SD="$WORK/search"; mkdir -p "$SD"
printf -- '## Brave Browser — 2 tabs\n\n- [ ] [Super Egg Drop - LeetCode](https://leetcode.com/problems/super-egg-drop/)\n- [ ] [Bus Routes](https://leetcode.com/problems/bus-routes/)\n' > "$SD/tabs_2026-01-01_09-00-00.md"
printf -- '## Brave Browser — 1 tabs\n\n- [x] [Super Egg Drop - LeetCode](https://leetcode.com/problems/super-egg-drop/)\n' > "$SD/tabs_2026-01-03_09-00-00.md"
printf -- '## DP (1)\n\n- [ ] [Bus Routes](https://leetcode.com/problems/bus-routes/) — BFS over routes, hard graph problem `📖 read later`\n' > "$SD/tabs_2026-01-01_09-00-00.triage.md"
out=$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search EGG drop --json)
expect "search is case-insensitive, all words" "$out" '"title": "Super Egg Drop - LeetCode"'
expect "search reports latest sighting" "$(print -r -- "$out" | jq -r '.[0].last_seen')" "2026-01-03 09:00"
expect "search counts snapshots" "$(print -r -- "$out" | jq -r '.[0].snapshots')" "2"
expect "search shows ticked state" "$(print -r -- "$out" | jq -r '.[0].done')" "true"
out=$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search bfs graph --json)
expect "search matches triage notes" "$(print -r -- "$out" | jq -r '.[0].url')" "bus-routes"
expect "note-only match still counts snapshots" "$(print -r -- "$out" | jq -r '.[0].snapshots')" "1"
expect "search text output" "$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search egg)" "seen in 2 snapshots"
expect "search with no hits" "$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search zzz)" "No tabs match"
expect "search needs words" "$("$REPO/tabsnap" search 2>&1)" "usage: tabsnap search"
expect "search empty dir json" "$(TABSNAP_DIR="$WORK/nothing" "$REPO/tabsnap" search x --json)" "[]"
expect "search knows the browser" "$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search egg --json | jq -r '.[0].browser')" "Brave Browser"
printf -- '## Safari — 1 tabs\n\n- [ ] [Plain page](https://example.com/page?utm=zzzqqq#frag)\n' > "$SD/tabs_2026-01-02_09-00-00.md"
expect_not "search ignores query strings" "$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search zzzqqq --json)" "example.com"
out=$(TABSNAP_DIR="$SD" "$REPO/tabsnap" search leetcode --restore --dry-run)
expect "search --restore previews" "$out" "Would reopen 2 tabs from 2 requested pages:"
expect "search --restore uses saved browser" "$out" "[Brave Browser] https://leetcode.com/problems/super-egg-drop/"
expect "--dry-run needs --restore" "$("$REPO/tabsnap" search x --dry-run 2>&1)" "--dry-run goes with --restore"

echo "restore specific pages"
out=$("$REPO/tabsnap" restore --dry-run --url https://e.com/a --url=https://e.com/b --url https://e.com/a --browser safari)
expect "--url dedupes and targets browser" "$out" "Would reopen 2 tabs from 3 requested pages (skipped 1 duplicate"
expect "--url uses --browser" "$out" "[Safari] https://e.com/b"
out=$(print -r -- '[{"url":"https://e.com/a","browser":"Safari"},{"url":"https://e.com/b"},{"title":"no url"}]' | "$REPO/tabsnap" restore --from-json - --dry-run)
expect "--from-json keeps each browser" "$out" "[Safari] https://e.com/a"
expect "--from-json skips entries without url" "$out" "Would reopen 2 tabs"
expect "--from-json rejects non-lists" "$(print -r -- '{"url":"x"}' | "$REPO/tabsnap" restore --from-json - --dry-run 2>&1)" "needs a JSON list"
expect "file and --url conflict" "$("$REPO/tabsnap" restore x.md --url https://e.com 2>&1)" "not both"

echo "snapshot"
# Reads whatever browsers are running (none on CI); only checks the file gets written.
out=$(TABSNAP_DIR="$WORK/capture" "$REPO/tabsnap" "ci note" 2>&1)
expect "snapshot saves file" "$out" "Saved "
file=("$WORK"/capture/tabs_*.md(N))
[[ -n "$file" ]] && expect "snapshot has note" "$(cat "$file[1]")" "> ci note" || fail "snapshot file exists"
out=$(TABSNAP_DIR="$WORK/capture2" "$REPO/tabsnap" 'keeps \n and $HOME literally' 2>&1)
file=("$WORK"/capture2/tabs_*.md(N))
[[ -n "$file" ]] && expect "note keeps backslashes" "$(cat "$file[1]")" '> keeps \n and $HOME literally' || fail "second snapshot file exists"
out=$(TABSNAP_DIR="$WORK/json" "$REPO/tabsnap" --json 2>/dev/null)
print -r -- "$out" | jq -e 'has("file") and has("total") and has("closed")' >/dev/null && ok "snapshot --json prints only JSON" || fail "snapshot --json prints only JSON" "$out"
TABSNAP_DIR="$WORK/same" "$REPO/tabsnap" a >/dev/null 2>&1; TABSNAP_DIR="$WORK/same" "$REPO/tabsnap" b >/dev/null 2>&1
same=("$WORK"/same/tabs_*.md(N)); [[ ${#same} == 2 ]] && ok "same-second snapshots don't overwrite" || fail "same-second snapshots don't overwrite" "${#same} files"

echo
echo "$PASS passed, $FAIL failed"
(( FAIL == 0 ))
