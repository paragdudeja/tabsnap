#!/bin/zsh
# tests/live — end-to-end tests against a real, running Brave Browser.
# Opens its own windows (one named "tabsnap-live-test", one incognito), only ever
# targets those, and aborts if any other window's tabs change. Run before a release:
#   tests/live            (Brave must be running; your windows are left alone)

REPO="${0:A:h:h}"
TS="$REPO/tabsnap"
NAME="tabsnap-live-test"
WORK=$(mktemp -d)
export TABSNAP_DIR="$WORK/snaps" TABSNAP_CONFIG="$WORK/none" TABSNAP_KEEP="example.org"
PASS=0
FAIL=0
ok()   { PASS=$((PASS + 1)); echo "  ✓ $1"; }
fail() { FAIL=$((FAIL + 1)); echo "  ✗ $1"; [[ -n "$2" ]] && echo "$2" | sed 's/^/      /'; }
expect() { [[ "$2" == *"$3"* ]] && ok "$1" || fail "$1" "expected: $3"$'\n'"got: $2"; }
expect_not() { [[ "$2" != *"$3"* ]] && ok "$1" || fail "$1" "unexpected: $3"$'\n'"got: $2"; }
jxa() { osascript -l JavaScript -e "const b = Application('Brave Browser'); $1"; }

# Fingerprint of every window we did NOT create: id + sorted URLs
others() { jxa "b.windows().filter(w => w.givenName() !== '$NAME' && w.id() != '${INCOG_ID:-0}').map(w => w.id() + ':' + w.tabs().map(t => t.url()).sort().join(',')).sort().join('\n')"; }
test_tabs() { jxa "b.windows().filter(w => w.givenName() === '$NAME').map(w => w.tabs().map(t => t.url()).join('\n')).join('\n')"; }

cleanup() {
  # Close only what we created: our named window and our incognito window
  # Same as tabsnap --close: tab by tab, never window.close() (that crashed Brave twice)
  jxa "b.windows().filter(w => w.givenName() === '$NAME' || w.id() == '${INCOG_ID:-0}').forEach(w => { const t = w.tabs(); for (let i = t.length - 1; i >= 0; i--) t[i].close(); })" >/dev/null 2>&1
  rm -rf "$WORK"
}
trap cleanup EXIT

jxa "b.running()" | grep -q true || { echo "Brave Browser isn't running; start it and re-run."; exit 1; }
BEFORE=$(others)

echo "setup"
jxa "
  b.Window().make(); delay(1);
  const w = b.windows[0];
  w.activeTab.url = 'https://example.com/live-1';
  for (const u of ['https://example.com/live-2?token=SECRET#frag', 'https://www.example.org/kept', 'https://example.com/live-1'])
    w.tabs.push(b.Tab({url: u}));
  delay(2); w.givenName = '$NAME'; 'ok'" >/dev/null
INCOG_ID=$(jxa "const w = b.Window({mode: 'incognito'}).make(); delay(1); b.windows[0].activeTab.url = 'https://example.com/incognito-secret'; delay(1); b.windows[0].id()" 2>/dev/null)
# Bring our test window to the front so 'front' and restore target it
jxa "b.windows().find(w => w.givenName() === '$NAME').index = 1; 'ok'" >/dev/null
sleep 1
[[ "$(test_tabs | wc -l | tr -d ' ')" == 4 ]] && ok "test window has 4 tabs (1 duplicate)" || { fail "test window setup" "$(test_tabs)"; exit 1; }
[[ -n "$INCOG_ID" ]] && ok "incognito window opened" || fail "incognito window opened"

echo "snapshot"
out=$("$TS" --window "$NAME" "live test" 2>&1)
expect "named window snapshot" "$out" "Saved 4 tabs (window \"$NAME\")"
snap=("$TABSNAP_DIR"/tabs_*.md(N.om)); snap="$snap[1]"
md=$(cat "$snap")
expect "records scope" "$md" "**Scope:** window \"$NAME\""
expect "keeps full url in file" "$md" "live-2?token=SECRET#frag"
expect_not "named snapshot excludes your windows" "$md" "## Safari"
out=$("$TS" --browser brave 2>&1)
expect "incognito skipped" "$out" "incognito tabs (not saved, not closed)"
all=("$TABSNAP_DIR"/tabs_*.md(N.om)); expect_not "incognito url never written" "$(cat "$all[1]")" "incognito-secret"
out=$("$TS" --window front 2>&1)
expect "front window = our window" "$out" "Saved 4 tabs (front window)"

echo "count"
c=$("$TS" count)
[[ "$c" == <-> ]] && ok "count is a number ($c)" || fail "count is a number" "$c"
[[ "$c" == "$(jxa "b.windows().filter(w => w.mode() !== 'incognito').reduce((n, w) => n + w.tabs.length, 0)")" ]] && ok "count matches non-incognito tabs" || fail "count matches non-incognito tabs"

echo "close"
out=$("$TS" --close --window "$NAME" 2>&1)
expect "closes all but kept" "$out" "Closed 3 tabs (kept 1 on your keep list)"
left=$(test_tabs)
[[ "$left" == "https://www.example.org/kept" ]] && ok "only the keep-list tab remains" || fail "only the keep-list tab remains" "$left"
# If you browse while this runs, this check can fail; it stops the run to be safe
[[ "$(others)" == "$BEFORE" ]] && ok "your other windows are untouched" || { fail "your other windows are untouched (stopping)" "$(others)"; exit 1; }
[[ -n "$(jxa "b.windows().filter(w => w.id() == '$INCOG_ID').length" | grep 1)" ]] && ok "incognito window survived --close" || fail "incognito window survived --close"

echo "restore"
out=$("$TS" restore --dry-run "$snap")
expect "dry run lists unique saved tabs" "$out" "Would reopen 3 tabs from ${snap:t} (skipped 1 duplicate"
expect "restores to Brave" "$out" "[Brave Browser] https://example.com/live-1"
sed -i '' 's|^- \[ \] \(.*live-2\)|- [x] \1|' "$snap"
expect "ticked tab is skipped" "$("$TS" restore --dry-run "$snap")" "Would reopen 2 tabs"
jxa "b.windows().find(w => w.givenName() === '$NAME').index = 1; 'ok'" >/dev/null; sleep 1
out=$("$TS" restore "$snap" 2>&1); sleep 3
expect "restore reports count" "$out" "Reopened 2 tabs"
now=$(test_tabs)
[[ "$(print -r -- "$now" | grep -c 'example.com/live-1')" == 1 ]] && ok "restore opened the duplicate once" || fail "restore opened the duplicate once" "$now"
expect "restore mentions skipped duplicate" "$out" "skipped 1 duplicate"
[[ "$(others)" == "$BEFORE" ]] && ok "restore didn't touch your other windows" || fail "restore didn't touch your other windows" "$(others)"

echo "triage (live, uses your Claude login or API key)"
if command -v claude >/dev/null || [[ -n "$ANTHROPIC_API_KEY" ]]; then
  out=$("$TS" triage "$snap" 2>&1)
  expect "triage saved" "$out" "Saved triage"
  tri="${snap%.md}.triage.md"
  t=$(cat "$tri" 2>/dev/null)
  [[ "$(print -r -- "$t" | grep -c '^- \[ \]')" == 4 ]] && ok "every tab appears exactly once" || fail "every tab appears exactly once" "$t"
  expect_not "notes don't cite internal ids" "$t" "tab 1"
  expect "triage keeps full url" "$t" "token=SECRET"
else
  echo "  - skipped (no claude CLI or ANTHROPIC_API_KEY)"
fi

echo
echo "$PASS passed, $FAIL failed"
(( FAIL == 0 ))
