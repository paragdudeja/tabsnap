#!/bin/zsh
# tabsnap — save every open browser tab to a timestamped markdown file.
# Usage: tabsnap [--close] [--triage] [--browser NAME] [--window front|NAME] [note]
#   --close    close the saved tabs after the snapshot is written (skips the keep list)
#   --triage   have Claude group and annotate the snapshot (see tabsnap-triage)
#   --browser  only this browser: brave, chrome, arc, edge or safari
#   --window   only the front window, or a window you named in Chrome/Brave/Edge
#   e.g. tabsnap --close --window front "done with this research"
#        tabsnap setup   grant browser access, write a config file, link the menu bar plugin
#        tabsnap triage [snapshot.md]   triage an existing snapshot (default: latest)
#        tabsnap restore [--all] [--all-copies] [--dry-run] [file.md]   reopen unticked tabs, once per URL
#        tabsnap count   print how many tabs are open (never launches a browser)
#        tabsnap config  show the config file path and current settings
# Incognito windows are never saved, counted or closed.

set -e
HERE="${0:A:h}"
VERSION=0.2.3
case "$1" in
  -h|--help) sed -n '2,14s/^# \{0,1\}//p' "$0"; exit 0 ;;
  -v|--version) echo "tabsnap $VERSION"; exit 0 ;;
esac

# Config file: "key = value" lines, later lines win. Environment variables win over the file.
CONFIG="${TABSNAP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tabsnap/config}"
typeset -A cfg
if [[ -f "$CONFIG" ]]; then
  while IFS='=' read -r key value || [[ -n "$key" ]]; do
    key="${key//[[:space:]]/}"
    [[ -z "$key" || "$key" == \#* ]] && continue
    value="${value#"${value%%[![:space:]]*}"}"
    value="${value%"${value##*[![:space:]]}"}"
    case "$key" in
      dir|warn|keep|model) cfg[$key]="$value" ;;
      *) echo "tabsnap: ignoring unknown key '$key' in $CONFIG" >&2 ;;
    esac
  done < "$CONFIG"
fi
export TABSNAP_CONFIG="$CONFIG"
export TABSNAP_DIR="${TABSNAP_DIR:-${${cfg[dir]:-$HOME/tab-snapshots}/#\~/$HOME}}"
export TABSNAP_WARN="${TABSNAP_WARN:-${cfg[warn]:-30}}"
export TABSNAP_KEEP="${TABSNAP_KEEP-${cfg[keep]}}"
export TABSNAP_MODEL="${TABSNAP_MODEL:-${cfg[model]:-claude-opus-5-5}}"

# Shared by every JXA snippet below: browser list, incognito check, permission errors.
JXA_COMMON='
const BROWSERS = [
  ["Brave Browser", "chromium"], ["Google Chrome", "chromium"], ["Arc", "chromium"],
  ["Microsoft Edge", "chromium"], ["Safari", "safari"],
];
// Chromium windows report mode "incognito"; Safari has no way to tell private windows apart.
const isIncognito = w => { try { return w.mode() === "incognito"; } catch (e) { return false; } };
// -1743: user said no to automation; -1744: macOS could not ask
const isDenied = e => e.errorNumber === -1743 || e.errorNumber === -1744;
const runningApp = name => { try { const a = Application(name); return a.running() ? a : null; } catch (e) { return null; } };
'

denied_help() {  # $1 = JSON array of browser names
  local names=$(echo "$1" | jq -r 'join(", ")')
  cat >&2 <<EOF
tabsnap isn't allowed to read tabs from: $names
Fix: System Settings → Privacy & Security → Automation → enable $names
     under the app you ran tabsnap from (Terminal, iTerm, SwiftBar, …).
     Or run: open "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation"
EOF
}

case "$1" in
  triage|restore|setup) cmd="$1"; shift; exec "$HERE/tabsnap-$cmd" "$@" ;;
  config)
    echo "config file: $CONFIG$([[ -f "$CONFIG" ]] || echo " (not created; run tabsnap setup)")"
    echo "dir   = $TABSNAP_DIR"
    echo "warn  = $TABSNAP_WARN"
    echo "keep  = $TABSNAP_KEEP"
    echo "model = $TABSNAP_MODEL"
    exit 0 ;;
  count)
    RES=$(osascript -l JavaScript <<JXA
$JXA_COMMON
let n = 0, denied = [];
for (const [name] of BROWSERS) {
  const app = runningApp(name);
  if (!app) continue;
  try {
    for (const w of app.windows()) if (!isIncognito(w)) n += w.tabs.length;
  } catch (e) { if (isDenied(e)) denied.push(name); }
}
JSON.stringify({n, denied});
JXA
)
    print -r -- "$RES" | jq -r .n
    DENIED=$(print -r -- "$RES" | jq -c .denied)
    [[ "$DENIED" == "[]" ]] || { denied_help "$DENIED"; exit 3; }
    exit 0 ;;
esac

CLOSE=0
TRIAGE=0
NOTE=""
BROWSER_ARG=""
WINDOW_ARG=""
while (( $# )); do
  case "$1" in
    --close) CLOSE=1 ;;
    --triage) TRIAGE=1 ;;
    --browser|--window)
      [[ -n "$2" ]] || { echo "tabsnap: $1 needs a value" >&2; exit 2; }
      [[ "$1" == --browser ]] && BROWSER_ARG="$2" || WINDOW_ARG="$2"
      shift ;;
    --browser=*) BROWSER_ARG="${1#*=}" ;;
    --window=*) WINDOW_ARG="${1#*=}" ;;
    -*) echo "tabsnap: unknown option $1 (see tabsnap --help)" >&2; exit 2 ;;
    *) NOTE="${NOTE:+$NOTE }$1" ;;
  esac
  shift
done

if [[ -n "$BROWSER_ARG" ]]; then
  matches=()
  for b in "Brave Browser" "Google Chrome" "Arc" "Microsoft Edge" "Safari"; do
    [[ "${(L)b}" == *"${(L)BROWSER_ARG}"* ]] && matches+=("$b")
  done
  (( ${#matches} == 1 )) || { echo "tabsnap: --browser '$BROWSER_ARG' should be one of: brave, chrome, arc, edge, safari" >&2; exit 2; }
  BROWSER_ARG="$matches[1]"
fi

OUT_DIR="$TABSNAP_DIR"
mkdir -p "$OUT_DIR"
STAMP=$(date +"%Y-%m-%d_%H-%M-%S")
HUMAN=$(date +"%Y-%m-%d %H:%M:%S %Z")
FILE="$OUT_DIR/tabs_$STAMP.md"
n=2; while [[ -e "$FILE" ]]; do FILE="$OUT_DIR/tabs_${STAMP}_$((n++)).md"; done  # two snapshots in one second

CAPTURE_JS=$(cat <<'JXA'
ObjC.import("AppKit");
function run(argv) {
  const [onlyBrowser, windowSel] = argv;
  const esc = s => (s || "(untitled)").replace(/([\[\]])/g, "\\$1").replace(/\s+/g, " ").trim();
  const nameOf = w => { try { return w.givenName() || ""; } catch (e) { try { return w.name() || ""; } catch (e2) { return ""; } } };
  let targets = BROWSERS.filter(([n]) => !onlyBrowser || n === onlyBrowser)
                        .map(([n, kind]) => [n, kind, runningApp(n)]).filter(t => t[2]);
  // "front" means the front window of whichever browser you were last using
  if (windowSel === "front" && targets.length > 1) {
    const front = $.NSWorkspace.sharedWorkspace.frontmostApplication.localizedName.js;
    const hit = targets.filter(t => t[0] === front);
    if (!hit.length) return JSON.stringify({error: "front-ambiguous", running: targets.map(t => t[0])});
    targets = hit;
  }
  let out = [], total = 0, urls = {}, denied = [], skipped = 0, names = [];
  for (const [name, kind, app] of targets) {
    let wins;
    try { wins = app.windows(); wins.length; } catch (e) { if (isDenied(e)) denied.push(name); continue; }
    if (windowSel === "front") wins = wins.slice(0, 1);
    else if (windowSel) {
      wins.forEach(w => { const n = nameOf(w); if (n) names.push(`${n} (${name})`); });
      wins = wins.filter(w => nameOf(w).toLowerCase() === windowSel.toLowerCase());
    }
    let section = [], count = 0;
    wins.forEach((w, i) => {
      let tabs;
      try { tabs = w.tabs(); } catch (e) { if (isDenied(e) && !denied.includes(name)) denied.push(name); return; }
      if (!tabs.length) return;
      if (isIncognito(w)) { skipped += tabs.length; return; }
      const label = windowSel === "front" ? "Front window" : windowSel ? `Window "${nameOf(w)}"` : `Window ${i + 1}`;
      section.push(`### ${label} (${tabs.length} tabs)\n`);
      const kept = [];
      for (const t of tabs) {
        const title = kind === "safari" ? t.name() : t.title();
        const url = t.url();
        if (!url) continue;
        section.push(`- [ ] [${esc(title)}](${url})`);
        kept.push(url);
        count++;
      }
      // Remember which window each URL came from, so --close only touches these windows
      (urls[name] = urls[name] || {})[w.id()] = kept;
      section.push("");
    });
    if (count) { out.push(`## ${name} — ${count} tabs\n`, ...section); total += count; }
  }
  if (windowSel && windowSel !== "front" && !total && !skipped && !denied.length)
    return JSON.stringify({error: "no-window", names});
  return JSON.stringify({total, urls, denied, skipped, body: out.join("\n")});
}
JXA
)
RAW=$(print -r -- "$JXA_COMMON$CAPTURE_JS" | osascript -l JavaScript - "$BROWSER_ARG" "$WINDOW_ARG")

case "$(print -r -- "$RAW" | jq -r '.error // empty')" in
  front-ambiguous)
    echo "tabsnap: --window front: more than one browser is open ($(print -r -- "$RAW" | jq -r '.running | join(", ")'))" >&2
    echo "and none of them is the frontmost app. Add --browser, e.g. tabsnap --window front --browser brave" >&2
    exit 2 ;;
  no-window)
    echo "tabsnap: no window named '$WINDOW_ARG'." >&2
    named=$(print -r -- "$RAW" | jq -r '.names | unique | .[]')
    if [[ -n "$named" ]]; then echo "Named windows: ${(j:, :)${(f)named}}" >&2
    else echo "Name a window in Chrome, Brave or Edge: right-click the tab strip → Name window…" >&2; fi
    exit 2 ;;
esac

TOTAL=$(print -r -- "$RAW" | jq .total)
DENIED=$(print -r -- "$RAW" | jq -c .denied)
SKIPPED=$(print -r -- "$RAW" | jq .skipped)
if [[ "$DENIED" != "[]" ]]; then
  denied_help "$DENIED"
  (( TOTAL > 0 )) || exit 3
fi
if (( TOTAL == 0 )) && [[ -n "$BROWSER_ARG$WINDOW_ARG" ]]; then
  echo "Nothing to save: no tabs in ${WINDOW_ARG:+the $WINDOW_ARG window of }${BROWSER_ARG:-any open browser}$( (( SKIPPED )) && echo " (only incognito)")."
  exit 0
fi

SCOPE="${BROWSER_ARG}${BROWSER_ARG:+${WINDOW_ARG:+ · }}${WINDOW_ARG:+$([[ "$WINDOW_ARG" == front ]] && echo "front window" || echo "window \"$WINDOW_ARG\"")}"
{
  echo "# Tab snapshot — $HUMAN"
  echo
  [[ -n "$NOTE" ]] && print -r -- "> $NOTE" && echo
  echo "**Total tabs:** $TOTAL${SCOPE:+ · **Scope:** $SCOPE}"
  echo
  print -r -- "$RAW" | jq -r .body
} > "$FILE"

echo "Saved $TOTAL tabs${SCOPE:+ ($SCOPE)} → $FILE"
(( SKIPPED > 0 )) && echo "Skipped $SKIPPED incognito tabs (not saved, not closed)"

if (( CLOSE )) && (( TOTAL > 0 )); then
  # Only close tabs whose URLs were captured, only in the windows they were captured from,
  # and never ones on the keep list (matched by host, including subdomains)
  TO_CLOSE=$(print -r -- "$RAW" | jq -c --arg keep "$TABSNAP_KEEP" '
    ($keep | split(",") | map(gsub("^\\s+|\\s+$"; "") | ascii_downcase) | map(select(. != ""))) as $keep
    | def host: (capture("^[A-Za-z][A-Za-z0-9+.-]*://(?<h>[^/?#]+)")?.h // "")
                | sub("^[^@]*@"; "") | sub(":[0-9]+$"; "") | ascii_downcase;
      def kept: host as $h | any($keep[]; . as $k | $h == $k or ($h | endswith("." + $k)));
      .urls | map_values(map_values(map(select(kept | not))))')
  KEPT=$(( TOTAL - $(print -r -- "$TO_CLOSE" | jq '[.[][][]] | length') ))
  CLOSE_JS=$(cat <<'JXA'
function run(argv) {
  const saved = JSON.parse(argv[0]);
  let closed = 0;
  for (const name in saved) {
    const app = runningApp(name);
    if (!app) continue;
    for (const id in saved[name]) {
      const want = new Set(saved[name][id]);
      let w;
      try { w = app.windows.byId(Number(id)); w.id(); } catch (e) { continue; }  // window gone
      if (isIncognito(w)) continue;
      const tabs = w.tabs();
      const doomed = tabs.map(t => { try { return want.has(t.url()); } catch (e) { return false; } });
      if (doomed.every(Boolean)) {
        // Emptying the window: closing its last tab by script crashed Brave once, so
        // close all but one tab, then close the window itself.
        for (let i = tabs.length - 1; i >= 1; i--) { try { tabs[i].close(); closed++; } catch (e) {} }
        try { w.close(); closed++; } catch (e) {}
        continue;
      }
      for (let i = tabs.length - 1; i >= 0; i--) {
        if (doomed[i]) { try { tabs[i].close(); closed++; } catch (e) {} }
      }
    }
  }
  return closed;
}
JXA
)
  CLOSED=$(print -r -- "$JXA_COMMON$CLOSE_JS" | osascript -l JavaScript - "$TO_CLOSE")
  echo "Closed $CLOSED tabs$( (( KEPT > 0 )) && echo " (kept $KEPT on your keep list)")"
fi

# Triage last, so a failed API call never blocks saving or closing
if (( TRIAGE )) && (( TOTAL > 0 )); then
  "$HERE/tabsnap-triage" "$FILE" || echo "Triage failed; snapshot is still saved. Retry with: tabsnap triage \"$FILE\""
fi
