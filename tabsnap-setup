#!/bin/zsh
# tabsnap-setup — first-run setup: browser access, config file, menu bar counter,
# Claude Code skill, triage check. Safe to re-run; it never overwrites your config.
# Usage: tabsnap setup [--yes] [--no-menu-bar] [--no-skill]
#   --yes          accept every optional step without asking
#   --no-menu-bar  skip the SwiftBar menu bar counter
#   --no-skill     skip installing the Claude Code skill
# Without a terminal to answer questions (e.g. run by an agent), optional steps are
# only described, never installed, unless --yes is given.

HERE="${0:A:h}"
CONFIG="${TABSNAP_CONFIG:-${XDG_CONFIG_HOME:-$HOME/.config}/tabsnap/config}"
OUT_DIR="${TABSNAP_DIR:-$HOME/tab-snapshots}"
YES=0
MENU=1
SKILL=1
for arg in "$@"; do
  case "$arg" in
    --yes|-y) YES=1 ;;
    --no-menu-bar) MENU=0 ;;
    --no-skill) SKILL=0 ;;
    *) echo "tabsnap setup: unknown option $arg" >&2; exit 2 ;;
  esac
done
ok()   { echo "  ✓ $1"; }
warn() { echo "  ! $1"; }
todo() { echo "  → $1"; }
ask() {  # yes/no question, default yes; never blocks without a terminal
  (( YES )) && return 0
  [[ -t 0 && -t 1 ]] || return 1
  local reply
  read -r "reply?  ? $1 [Y/n] "
  [[ -z "$reply" || "$reply" == [Yy]* ]]
}
# Files that ship next to this script: the repo checkout, or Homebrew's share/tabsnap
shared() {
  local c
  for c in "$HERE/$1" "$(brew --prefix 2>/dev/null)/share/tabsnap/$1"; do
    [[ -e "$c" ]] && { print -r -- "$c"; return; }
  done
}

echo "Browser access"
# Asking a running browser for its windows makes macOS show the permission prompt once.
for name in "Brave Browser" "Google Chrome" "Arc" "Microsoft Edge" "Safari"; do
  open -Ra "$name" 2>/dev/null || continue
  result=$(osascript -l JavaScript - "$name" <<'JXA' 2>/dev/null
function run(argv) {
  const app = Application(argv[0]);
  if (!app.running()) return "not-running";
  try { app.windows().length; return "ok"; }
  catch (e) { return (e.errorNumber === -1743 || e.errorNumber === -1744) ? "denied" : "error"; }
}
JXA
)
  case "$result" in
    ok) ok "$name" ;;
    not-running) todo "$name is installed but not open — open it and re-run tabsnap setup to grant access" ;;
    denied)
      warn "$name: access denied"
      todo "enable it in System Settings → Privacy & Security → Automation, then re-run setup"
      denied=1 ;;
    *) warn "$name: couldn't check (${result:-no response})" ;;
  esac
done
[[ -n "$denied" ]] && open "x-apple.systempreferences:com.apple.preference.security?Privacy_Automation"

echo "Config"
if [[ -f "$CONFIG" ]]; then
  ok "using $CONFIG"
else
  mkdir -p "${CONFIG:h}"
  cat > "$CONFIG" <<EOF
# tabsnap config — "key = value". Environment variables (TABSNAP_DIR, …) override these.

# Where snapshots go. Point it at an Obsidian vault folder to keep them with your notes.
dir = ~/tab-snapshots

# Menu bar count turns orange at this many open tabs.
warn = 30

# How often the menu bar count updates (5s minimum; e.g. 10s, 30s, 1m).
refresh = 10s

# Never close tabs on these sites with --close (comma-separated; subdomains match too).
keep = mail.google.com, calendar.google.com

# Model used by tabsnap triage.
model = claude-opus-5-5
EOF
  ok "created $CONFIG (edit it to change folder, keep list, …)"
fi
mkdir -p "$OUT_DIR" && ok "snapshots go to $OUT_DIR"

echo "Menu bar counter (optional)"
plugin=$(shared swiftbar/tabsnap.1m.sh)
# SwiftBar reads the refresh interval from the file name, so the link is named after it
link_name="tabsnap.${TABSNAP_REFRESH:-10s}.sh"
default_dir="$HOME/Library/Application Support/SwiftBar/Plugins"
plugin_dir=$(defaults read com.ameba.SwiftBar PluginDirectory 2>/dev/null)
plugin_dir="${plugin_dir/#\~/$HOME}"
installed=()
[[ -n "$plugin_dir" ]] && installed=("$plugin_dir"/tabsnap.*.sh(N))
if (( ! MENU )); then
  todo "skipped (--no-menu-bar)"
elif [[ -n "$installed" ]] && grep -q '<xbar.title>tabsnap</xbar.title>' "$installed[1]" 2>/dev/null; then
  if [[ "${installed[1]:t}" != "$link_name" ]] && [[ -L "$installed[1]" ]]; then
    mv "$installed[1]" "$plugin_dir/$link_name" && open -g "swiftbar://refreshallplugins" 2>/dev/null
  fi
  ok "already in your menu bar (SwiftBar), refreshing every ${${link_name#tabsnap.}%.sh}"
elif [[ -n "$installed" ]]; then
  warn "$installed[1] exists and isn't the tabsnap plugin; leaving it alone"
elif [[ -z "$plugin" ]]; then
  warn "couldn't find the tabsnap menu bar plugin next to this install"
elif ask "Show your open-tab count in the menu bar? (uses the free SwiftBar app)"; then
  if ! open -Ra SwiftBar 2>/dev/null; then
    echo "    installing SwiftBar with Homebrew…"
    # Pre-set the plugin folder so SwiftBar's first launch doesn't ask for one
    [[ -n "$plugin_dir" ]] || defaults write com.ameba.SwiftBar PluginDirectory -string "$default_dir"
    brew install --cask swiftbar >/dev/null 2>&1 || { warn "couldn't install SwiftBar; try: brew install --cask swiftbar"; plugin=""; }
  fi
  if [[ -n "$plugin" ]]; then
    [[ -n "$plugin_dir" ]] || { plugin_dir="$default_dir"; defaults write com.ameba.SwiftBar PluginDirectory -string "$plugin_dir"; }
    mkdir -p "$plugin_dir"
    ln -s "$plugin" "$plugin_dir/$link_name" \
      && { pgrep -xq SwiftBar && open -g "swiftbar://refreshallplugins" || open -g -a SwiftBar; } \
      && ok "added to your menu bar; click it for snapshot, close, triage and restore"
  fi
else
  todo "later: tabsnap setup (or brew install --cask swiftbar, then tabsnap setup)"
fi

echo "AI agents (optional)"
skill=$(shared skills/tabsnap)
skill_dir="$HOME/.claude/skills/tabsnap"
if (( ! SKILL )); then
  todo "skipped (--no-skill)"
elif [[ -z "$skill" ]]; then
  warn "couldn't find the tabsnap skill next to this install"
elif ! command -v claude >/dev/null && [[ ! -d "$HOME/.claude" ]]; then
  todo "using another agent? point it at $skill/SKILL.md"
elif [[ -e "$skill_dir" ]]; then
  if grep -q '^name: tabsnap$' "$skill_dir/SKILL.md" 2>/dev/null; then ok "Claude Code skill installed: ask Claude \"what tabs do I have open?\""
  else warn "$skill_dir exists and isn't the tabsnap skill; leaving it alone"; fi
elif ask "Let Claude Code use tabsnap? (installs the tabsnap skill)"; then
  mkdir -p "${skill_dir:h}" && ln -s "$skill" "$skill_dir" \
    && ok "Claude Code skill installed: in a new session, ask \"what tabs do I have open?\""
else
  todo "later: tabsnap setup, or in Claude Code: /plugin install tabsnap --marketplace paragdudeja/tabsnap"
fi

echo "AI triage (optional)"
if [[ -n "$ANTHROPIC_API_KEY" ]]; then
  ok "will use your ANTHROPIC_API_KEY"
elif command -v claude >/dev/null; then
  ok "will use your Claude Code login (claude CLI)"
else
  todo "install Claude Code or set ANTHROPIC_API_KEY to use tabsnap triage"
fi

echo
echo "Try it: tabsnap    (or tabsnap --help)"
